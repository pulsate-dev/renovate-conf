{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "autoApprove": true,
  "automerge": true,
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "semanticCommitType": "chore",
  "minimumReleaseAge": "3 days",
  "timezone": "Asia/Tokyo",
  "enabledManagers": [
    "npm",
    "asdf",
    "mise",
    "github-actions",
    "dockerfile",
    "docker-compose"
  ],
  "reviewers": ["team:core"],
  "labels": ["T: renovate"],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "packages:eslint",
    "packages:react",
    "packages:vite"
  ],
  "schedule": ["before 3am"],
  "rollback": {
    "autoApprove": false,
    "automerge": false,
    "branchTopic": "{{{depNameSanitized}}}-rollback",
    "commitMessageAction": "Roll back",
    "semanticCommitType": "fix",
    "addLabels": ["T: hotfix", "requires core approval"],
    "additionalReviewers": ["team:core"],
    "schedule": ["at any time"]
  },
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false,
    "autoApprove": false,
    "automerge": false,
    "minimumReleaseAge": null,
    "rangeStrategy": "update-lockfile",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
    "prCreation": "immediate",
    "addLabels": ["T: hotfix", "requires core approval"],
    "additionalReviewers": ["team:core"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "autoApprove": false,
    "automerge": false
  },
  "packageRules": [
    {
      "matchManagers": ["asdf", "mise"],
      "autoApprove": false,
      "automerge": false
    },
    {
      "groupName": null,
      "matchUpdateTypes": ["major"],
      "autoApprove": false,
      "automerge": false
    },
    {
      "groupName": "Cloudflare Wrangler packages",
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/**"
      ]
    }
  ]
}
